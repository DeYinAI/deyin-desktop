{
  "name": "@deyin/branding",
  "version": "0.1.1",
  "description": "Deyin brand assets: logo, icons, and theme tokens.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": ["dist", "assets"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "rasterize": "node scripts/rasterize.mjs",
    "make-icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
