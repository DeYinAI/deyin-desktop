{
  "name": "@deyin/bundle-headless",
  "private": true,
  "version": "0.1.0",
  "description": "Headless profile layer \u2014 the minimal composition for CLI/headless runs (no interactive caps, no caches).",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeYinAI/deyin-desktop.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@deyin/bundle-base": "workspace:*",
    "@deyin/extension-api": "workspace:*",
    "@deyin/kernel": "workspace:*",
    "@deyin/llm": "workspace:*",
    "@deyin/plugin-llm-anthropic": "workspace:*",
    "@deyin/plugin-llm-openai": "workspace:*",
    "@deyin/plugin-llm-responses": "workspace:*",
    "@deyin/plugin-tools-agent": "workspace:*",
    "@deyin/plugin-tools-fs": "workspace:*",
    "@deyin/plugin-tools-git": "workspace:*",
    "@deyin/plugin-tools-plan": "workspace:*",
    "@deyin/plugin-tools-shell": "workspace:*",
    "@deyin/plugin-tools-web": "workspace:*",
    "@deyin/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
