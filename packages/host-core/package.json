{
  "name": "@deyin/host-core",
  "private": true,
  "version": "0.1.1",
  "description": "Deyin's runtime-agnostic core: shared domain types, Openference chat/model clients, web search, usage stats, JSON storage with secret ciphers, and host services (files, env, PTY). Consumed by the desktop app, the web host-server, and the CLI.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeYinAI/deyin-desktop.git",
    "directory": "packages/host-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0",
    "@deyin/native-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
