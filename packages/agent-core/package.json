{
  "name": "@deyin/agent-core",
  "private": true,
  "version": "0.1.1",
  "description": "Deyin's agentic runtime: OpenAI-compatible streaming with tool_calls accumulation, the agent loop, built-in tools (bash, read, write, edit, grep, glob, ls, websearch, todo), the permission engine, session persistence, layered config, prompts/compaction, and an MCP client. Consumed by the desktop app and CLI.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeYinAI/deyin-desktop.git",
    "directory": "packages/agent-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./goal-command": {
      "types": "./dist/capabilities/goal-command.d.ts",
      "import": "./dist/capabilities/goal-command.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts src/cache/__tests__/*.test.ts && tsx src/compression-parity.test.ts",
    "test:e2e": "tsx --test test/e2e/*.test.ts",
    "test:migration": "tsx --test test/migration.test.ts",
    "test:edge": "tsx --test test/edge-cases.test.ts",
    "test:load": "tsx --test test/load.test.ts",
    "test:agent-suite": "tsx --test test/*.test.ts test/e2e/*.test.ts src/cache/__tests__/*.test.ts",
    "benchmark": "tsx test/performance/run-benchmarks.ts",
    "bench:compaction": "tsx test/performance/compaction-bench.ts"
  },
  "dependencies": {
    "@deyin/host-core": "workspace:*",
    "@deyin/native-core": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
