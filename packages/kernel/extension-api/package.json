{
  "name": "@deyin/extension-api",
  "private": true,
  "version": "0.1.0",
  "description": "Deyin extension API — the zero-dependency contracts every plugin is written against: PluginDefinition, PluginContext, service keys, the shared event map, and config-row types. Nothing may depend on a concrete capability provider, only on seams declared here.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeYinAI/deyin-desktop.git",
    "directory": "packages/kernel/extension-api"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
