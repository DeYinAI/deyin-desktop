{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["../desktop/src/renderer/*"],
      "@contract/*": ["../desktop/src/shared/*"]
    }
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/shared/**/*.ts",
    "../desktop/src/renderer/**/*.ts",
    "../desktop/src/renderer/**/*.tsx",
    "../desktop/src/shared/**/*.ts"
  ]
}
