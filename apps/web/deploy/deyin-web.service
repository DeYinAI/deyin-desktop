[Unit]
Description=Deyin web host-server (chat.openference.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deyin
Group=deyin
WorkingDirectory=/opt/deyin/web/dist/server
EnvironmentFile=-/etc/deyin/web.env
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5

# Hardening (optional; remove if agent needs broad filesystem access in MVP).
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
