# Production identity is the Openference site itself:
#   DEYIN_OAUTH_ISSUER=https://openference.com   (the app default; deep-link sign-in)
# Point at a local OAuth provider for development instead by uncommenting below.
# Start the provider first:  pnpm oauth:dev   (listens on http://localhost:8788)
# DEYIN_OAUTH_ISSUER=http://localhost:8788

# For real model calls, leave the API base at Openference (needs a valid token/plan).
# For local end-to-end UI testing without a model, you can point this at a mock server.
DEYIN_API_BASE_URL=https://api.openference.com/v1

DEYIN_CLIENT_ID=deyin-desktop
