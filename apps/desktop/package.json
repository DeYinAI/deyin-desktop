{
  "name": "@deyin/desktop",
  "version": "2.1.10",
  "description": "Deyin desktop app (Electron). Agentic development environment with native computer use, billing, MCP servers, and plugin system.",
  "license": "MIT",
  "author": "Deyin <hello@deyin.dev>",
  "homepage": "https://deyin.dev",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "pnpm --filter \"@deyin/desktop^...\" build",
    "prebuild": "pnpm --filter \"@deyin/desktop^...\" build",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck": "pnpm typecheck:node",
    "test": "tsx --test test/*.test.ts bundled-plugins/security/test/*.test.ts",
    "package": "pnpm run build && electron-builder --publish never --config electron-builder.yml",
    "package:dir": "pnpm run build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "croner": "^10.0.1",
    "electron-updater": "^6.3.9",
    "playwright-core": "^1.49.0",
    "ssh2": "^1.17.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@deyin/agent-core": "workspace:*",
    "@deyin/branding": "workspace:*",
    "@deyin/bundle-base": "workspace:*",
    "@deyin/bundle-desktop-app": "workspace:*",
    "@deyin/contract": "workspace:*",
    "@deyin/extension-api": "workspace:*",
    "@deyin/host-core": "workspace:*",
    "@deyin/kernel": "workspace:*",
    "@deyin/llm": "workspace:*",
    "@deyin/oauth-client": "workspace:*",
    "@deyin/optimization-plugin": "workspace:*",
    "@deyin/tools": "workspace:*",
    "@deyin/ui": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
