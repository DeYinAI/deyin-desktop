{
  "name": "@deyin/desktop",
  "version": "2.1.5",
  "description": "Deyin desktop app (Electron). Agentic development environment with native computer use, billing, MCP servers, and plugin system.",
  "license": "MIT",
  "author": "Deyin <hello@deyin.dev>",
  "homepage": "https://deyin.dev",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "pnpm --filter @deyin/host-core --filter @deyin/agent-core --filter @deyin/computer-use-host --filter @deyin/optimization-plugin build",
    "prebuild": "pnpm --filter @deyin/host-core --filter @deyin/agent-core --filter @deyin/computer-use-host --filter @deyin/optimization-plugin build",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "tsx --test test/*.test.ts bundled-plugins/security/test/*.test.ts",
    "package": "pnpm run build && electron-builder --publish never --config electron-builder.yml",
    "package:dir": "pnpm run build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@stripe/stripe-js": "^9.12.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "croner": "^10.0.1",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "playwright-core": "^1.49.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@deyin/agent-core": "workspace:*",
    "@deyin/branding": "workspace:*",
    "@deyin/computer-use-host": "workspace:*",
    "@deyin/host-core": "workspace:*",
    "@deyin/oauth-client": "workspace:*",
    "@deyin/optimization-plugin": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
