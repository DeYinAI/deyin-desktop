{
  "name": "@deyin/cli",
  "version": "0.1.1",
  "description": "Deyin in your terminal: an agentic coding CLI (chat TUI + headless mode) with the same Openference account, models, agents and web search as the Deyin desktop app.",
  "license": "MIT",
  "author": "Deyin <hello@deyin.ai>",
  "homepage": "https://deyin.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeYinAI/deyin-desktop.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "deyin": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@deyin/agent-core": "workspace:*",
    "@deyin/host-core": "workspace:*",
    "@deyin/oauth-client": "workspace:*",
    "citty": "^0.1.6",
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
