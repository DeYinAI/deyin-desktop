{
  "name": "deyin-desktop",
  "private": true,
  "version": "1.0.3",
  "description": "Deyin - an original, web-hostable agentic development environment with Openference OAuth.",
  "type": "module",
  "author": "Deyin",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint packages/agent-core packages/host-core packages/ui/client apps/desktop apps/web apps/cli scripts/ci",
    "oauth:dev": "pnpm --filter @deyin/oauth-provider dev",
    "desktop:dev": "pnpm --filter @deyin/desktop dev",
    "web:dev": "pnpm --filter @deyin/web dev",
    "clean": "pnpm -r exec rm -rf dist out node_modules/.cache",
    "runs:summary": "tsx scripts/summarize-runs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "tar": "7.5.22"
    }
  }
}
