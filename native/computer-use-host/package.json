{
  "name": "@deyin/computer-use-host",
  "version": "1.0.0",
  "description": "Native Windows host for OS-level computer use (UIA + screen capture + input simulation via named pipe).",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "deyin-computer-use-host": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
