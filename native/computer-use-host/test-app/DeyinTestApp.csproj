<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A small WinForms window the computer-use end-to-end test drives. It records every event it receives
    (clicks, text, keys, focus changes, mouse positions) to a log file, so the test can prove what an action
    did and did not do. It is a test fixture only and is never shipped.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <AssemblyName>DeyinTestApp</AssemblyName>
    <RootNamespace>DeyinTestApp</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
