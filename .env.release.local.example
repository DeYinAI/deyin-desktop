# Copy to .env.release.local (gitignored) and fill in real values.
# Then run: bash scripts/sync-release-secrets.sh
#
# Do NOT commit .env.release.local or certificate files.

# GitHub PAT with contents:write on DeYinAI/deyin-releases
# RELEASES_TOKEN=ghp_...

# macOS code signing — base64-encoded .p12 or file path (CI uses env var directly)
# CSC_LINK=
# CSC_KEY_PASSWORD=

# macOS notarization
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Windows code signing — base64-encoded .pfx or file path
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=
